# CaptionForge server configuration

# Speech-to-text engine: "openai", "groq", or "fake" (deterministic offline
# engine for development). When unset, the first provider with a key is used:
# OpenAI, then Groq.
#CAPTIONFORGE_STT_ENGINE=groq

# OpenAI Whisper (paid; word-level timestamps).
#OPENAI_API_KEY=sk-...

# Groq-hosted Whisper (free tier, no card required) — console.groq.com.
#GROQ_API_KEY=gsk_...

# Browser executable for server-side Remotion rendering (export). When unset,
# Remotion downloads its own headless shell on first render.
#CAPTIONFORGE_BROWSER_EXECUTABLE=/usr/bin/chromium
